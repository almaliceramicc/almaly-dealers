+def prune_stale(tiles):
+    """Убирает QR и готовые картинки моделей, которых уже нет в каталоге.
+
+    Карточка, снятая на портале, пропадает из arts.txt. Ночная пересборка
+    собирает сайт заново и здесь стирает её QR и docs/img, чтобы старый файл
+    не оставался в репозитории. Исходники в photos/ не трогает — их снимает
+    зеркало портала в том же коммите, где убирает строку из arts.txt.
+    """
+    keep = {t["art"].upper().translate(CYR) for t in tiles}
+    if len(keep) < 10:
+        print("Снятие старых файлов пропущено: в каталоге меньше 10 моделей.")
+        return
+    def label(path):
+        try:
+            return str(path.relative_to(ROOT))
+        except ValueError:
+            return path.name
+
+    removed = []
+    for folder in (QR, SITE / "qr"):
+        if not folder.is_dir():
+            continue
+        for path in list(folder.glob("*.png")):
+            if path.stem.upper().translate(CYR) not in keep:
+                path.unlink()
+                removed.append(label(path))
+    img = SITE / "img"
+    if img.is_dir():
+        for path in list(img.iterdir()):
+            if not path.is_dir() or path.name.upper().translate(CYR) in keep:
+                continue
+            if not re.fullmatch(r"[0-9A-Za-zА-Яа-яЁё_-]{4,32}", path.name):
+                continue
+            shutil.rmtree(path)
+            removed.append(label(path) + "/")
+    if removed:
+        print("Сняты материалы моделей вне каталога:", ", ".join(removed))
+
+
